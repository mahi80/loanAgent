# Copy to .streamlit/secrets.toml (git-ignored) and set AUTH_MODE=oidc in .env.
# Streamlit's built-in OIDC login (st.login) - works with Entra ID, Cognito, Okta, Auth0, Google.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # one per app/port: 8502 for the demand app
cookie_secret = "<long random string>"
client_id = "<app registration client id>"
client_secret = "<client secret>"
# Microsoft Entra ID:
server_metadata_url = "https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration"
# Amazon Cognito:
# server_metadata_url = "https://cognito-idp.<region>.amazonaws.com/<user-pool-id>/.well-known/openid-configuration"
