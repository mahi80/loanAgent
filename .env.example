# LLM_MODE: auto (azure -> openai -> mock, whichever is configured) | azure | openai | mock
LLM_MODE=auto

# Option A: Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Option B: OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option C: local Ollama (no key; data stays on this machine)
# OLLAMA_MODEL=gemma4:e4b
# OLLAMA_BASE_URL=http://localhost:11434/v1      # docker-compose overrides this to host.docker.internal
# OLLAMA_REASONING=none                          # none = fast extraction; "default" keeps model thinking on

# --- Authentication -------------------------------------------------------
# demo (default): pick a demo identity in the sidebar (POC; role bound to identity)
# oidc: SSO via Streamlit st.login - configure .streamlit/secrets.toml (see .streamlit/secrets.toml.example)
AUTH_MODE=demo
# AUTH_ROLE_CLAIM=roles
# AUTH_ROLE_MAP={"credit-sco": "Senior Credit Officer", "sop-lead": "S&OP Lead"}

# --- Observability --------------------------------------------------------
# Spans always go to runtime/traces.jsonl. Set these (and pip install opentelemetry-sdk
# opentelemetry-exporter-otlp) to also export to Langfuse / Jaeger / X-Ray (ADOT) / App Insights.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=agentic-poc
